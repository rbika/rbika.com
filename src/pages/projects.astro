---
import PageLayout from '../layouts/PageLayout.astro';
import '../styles/global.css';
import ProjectListItem from '@components/ProjectListItem.astro';
import { projects } from '../content/projects';
---

<PageLayout title="Projects" description="Software I've built.">
  <header class="mb-8">
    <h1 class="text-xl font-semibold text-black dark:text-white">Projects</h1>
  </header>

  <ul class="border-t border-zinc-300 dark:border-zinc-700">
    {
      projects.map((project) => (
        <li class="border-b border-zinc-300 dark:border-zinc-700">
          <ProjectListItem project={project} />
        </li>
      ))
    }
  </ul>
</PageLayout>
