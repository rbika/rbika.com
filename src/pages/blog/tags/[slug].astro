---
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import '../../../styles/global.css';
import PostsListItem from '@components/PostsListItem.astro';
import { formatDate } from '../../../utils.ts';
import { tagsInUse } from '../../../content/tags';
import { buttonVariants } from '@components/ui/button';
import { cn } from 'cn';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const usedTags = tagsInUse(posts.flatMap((post) => post.data.tags));

  return usedTags.map((tag) => ({
    params: { slug: tag.slug },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.includes(tag.slug))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<PageLayout title={tag.label} description="Front-end developer.">
  <header class="mb-8">
    <div class="flex items-center gap-2">
      <h1 class="text-xl font-semibold text-black dark:text-white">Blog</h1>
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
      <span class="text-sm font-semibold">Tag:</span>
      <span><span class="font-mono text-[11px]">{tag.label}</span></span>
      <a
        href="/blog"
        class={cn(
          buttonVariants({ variant: 'outline', size: 'xs' }),
          'ml-auto',
        )}
      >
        Clear filter
      </a>
    </div>
  </header>

  <ul class="border-t border-zinc-300 dark:border-zinc-700">
    {
      posts.map((post) => (
        <li class="border-b border-zinc-300 dark:border-zinc-700">
          <PostsListItem
            url={post.id}
            title={post.data.title}
            tags={post.data.tags}
            date={formatDate(post.data.date)}
          />
        </li>
      ))
    }
  </ul>
</PageLayout>
