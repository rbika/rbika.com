---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import '../../styles/global.css';
import PostsListItem from '@components/PostsListItem.astro';
import TagLink from '@components/TagLink.astro';
import { formatDate } from '../../utils.ts';
import { tagsInUse } from '../../content/tags';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const usedTags = tagsInUse(posts.flatMap((post) => post.data.tags));
---

<PageLayout title="" description="Front-end developer.">
  <header class="mb-8">
    <div class="flex items-center gap-2">
      <h1 class="text-xl font-semibold text-black dark:text-white">Blog</h1>
    </div>
    <ul class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
      <li class="text-sm font-semibold">Tags:</li>
      {
        usedTags.map((tag) => (
          <li>
            <TagLink slug={tag.slug} class="text-[11px] opacity-70" />
          </li>
        ))
      }
    </ul>
  </header>

  <ul class="border-t border-zinc-300 dark:border-zinc-700">
    {
      sortedPosts.map((post) => (
        <li class="border-b border-zinc-300 dark:border-zinc-700">
          <PostsListItem
            url={post.id}
            title={post.data.title}
            tags={post.data.tags}
            date={formatDate(post.data.date)}
          />
        </li>
      ))
    }
  </ul>
</PageLayout>
