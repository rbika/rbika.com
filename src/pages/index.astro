---
import PageLayout from '../layouts/PageLayout.astro';
import '../styles/global.css';
import { cn } from 'cn';
import { buttonVariants } from '@components/ui/button';
import { RiGithubFill, RiRssFill, RiTwitterXFill } from '@remixicon/react';

const socialLinks = [
  {
    label: 'X/Twitter',
    icon: RiTwitterXFill,
    iconClass: 'size-[16px]!',
    url: 'https://x.com/rbika',
  },
  {
    label: 'Github',
    icon: RiGithubFill,
    iconClass: 'size-[18px]!',
    url: 'https://github.com/rbika',
  },
  {
    label: 'RSS',
    icon: RiRssFill,
    iconClass: 'size-[16px]!',
    url: '/rss.xml',
  },
];
---

<PageLayout title="" description="Front-end developer.">
  <div class="flex flex-col gap-6">
    <p>
      Hi, my name is Rafael but you can call me <span class="font-semibold"
        >Bika</span
      >/<span class="font-semibold">Bikas</span>.
    </p>

    <p>
      I occasionally write about web development and productivity tips on my <a
        href="/blog"
        class="underline underline-offset-3">blog</a
      >. I also enjoy building small <a
        href="/projects"
        class="underline underline-offset-3">projects</a
      >, either for fun or to make everyday tasks easier. If you're curious
      about the apps and tools I use, you can find them on my <a
        href="/uses"
        class="underline underline-offset-3">Uses</a
      > page.
    </p>

    <ul class="mt-4 flex gap-2">
      {
        socialLinks.map((item) => {
          const { label, icon: Icon, iconClass, url } = item;
          return (
            <li>
              <a
                href={url}
                target="_blank"
                rel="noreferrer"
                class={cn(
                  'focus:text-primary flex items-center gap-2! no-underline',
                  buttonVariants({ variant: 'outline', size: 'sm' }),
                )}
              >
                <Icon className={iconClass} />
                <span class="hidden text-sm sm:block" aria-label={label}>
                  {label}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</PageLayout>
