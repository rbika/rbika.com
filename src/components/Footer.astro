---
import { RiGithubFill, RiRssFill, RiTwitterXFill } from '@remixicon/react';
import Container from './Container.astro';
---

<footer class="pt-15 pb-5 text-sm">
  <Container>
    <div class="flex items-center justify-between">
      <span>&copy; {new Date().getFullYear()} rbika.com</span>
      <ul class="flex items-center gap-2">
        <li>
          <a
            href="https://x.com/rbika"
            target="_blank"
            rel="noopener noreferrer"
            ><RiTwitterXFill
              className="size-3.5 opacity-80 transition-opacity hover:opacity-100"
            /></a
          >
        </li>
        <li>
          <a
            href="https://github.com/rbika"
            target="_blank"
            rel="noopener noreferrer"
            ><RiGithubFill
              className="size-4 opacity-80 transition-opacity hover:opacity-100"
            /></a
          >
        </li>
        <li>
          <a
            href="https://rbika.com/rss.xml"
            target="_blank"
            rel="noopener noreferrer"
            ><RiRssFill
              className="size-3.5 opacity-80 transition-opacity hover:opacity-100"
            /></a
          >
        </li>
      </ul>
    </div>
  </Container>
</footer>
