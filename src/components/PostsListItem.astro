---
import TagLink from './TagLink.astro';

interface Props {
  url: string;
  title: string;
  tags: string[];
  date: string;
}

const { url, title, tags, date } = Astro.props;
---

<div class="flex flex-col justify-between gap-2 pt-4 pb-5 sm:gap-1">
  <a
    href={`/blog/${url}`}
    class="flex flex-col justify-between no-underline sm:flex-row"
  >
    <span>{title}</span>
    <span class="text-sm">{date}</span>
  </a>
  <div class="flex flex-wrap gap-x-2 gap-y-1 text-xs">
    {
      tags.map((slug, index) => (
        <span class="flex items-center justify-center">
          <TagLink slug={slug} class="text-[11px] opacity-70" />
          {index != tags.length - 1 && <span class="opacity-70">,</span>}
        </span>
      ))
    }
  </div>
</div>
