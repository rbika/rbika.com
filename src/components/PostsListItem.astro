---
import { getTag } from '../content/tags';

interface Props {
  url: string;
  title: string;
  tags: string[];
  date: string;
}

const { url, title, tags, date } = Astro.props;
const tagLabels = tags.map((slug) => getTag(slug).label);
---

<a
  href={`/blog/${url}`}
  class="flex flex-col justify-between gap-2 pt-4 pb-5 no-underline sm:gap-1"
>
  <span class="flex flex-col justify-between sm:flex-row">
    <span>{title}</span>
    <span class="text-sm">{date}</span>
  </span>
  <span class="flex flex-wrap gap-x-2 gap-y-1 text-xs">
    {
      tagLabels.map((label) => (
        <span class="font-mono text-[11px] opacity-70">{label}</span>
      ))
    }
  </span>
</a>
