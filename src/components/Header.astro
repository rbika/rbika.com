---
import Container from './Container.astro';
import { MobileNav } from '@/components/MobileNav';
import { ModeToggle } from '@/components/ModeToggle';
import { NAV_ITEMS, isCurrentPath, navItemClass } from '@/lib/nav';

const pathname =
  Astro.url.pathname !== '/' && Astro.url.pathname.endsWith('/')
    ? Astro.url.pathname.slice(0, -1)
    : Astro.url.pathname;
---

<header>
  <Container>
    <div class="mb-7 flex items-center justify-between py-7">
      <a
        href="/"
        class="text-[22px] font-bold tracking-widest text-zinc-800 dark:text-white"
      >
        R Bika(s)
      </a>
      <div class="hidden items-center gap-5 sm:flex">
        <nav class="flex justify-center gap-5 text-[15px]">
          {
            NAV_ITEMS.map(({ href, label }) => {
              const current = isCurrentPath(pathname, href);
              return (
                <a
                  href={href}
                  class={navItemClass(current)}
                  aria-current={current ? 'page' : undefined}
                >
                  {label}
                </a>
              );
            })
          }
        </nav>
        <ModeToggle client:load />
      </div>
      <MobileNav client:load pathname={pathname} />
    </div>
  </Container>
</header>
