---
import Container from './Container.astro';
import { ModeToggle } from '@/components/ModeToggle';
---

<header>
  <Container>
    <div class="mb-7 flex items-center justify-between py-7">
      <a
        href="/"
        class="text-[22px] font-bold tracking-widest text-zinc-800 dark:text-white"
      >
        R Bika(s)
      </a>
      <div class="flex items-center gap-5">
        <nav class="flex justify-center gap-5 text-[15px]">
          <a href="/" class="duration-300 hover:text-white">Home</a>
          <a href="/uses" class="duration-300 hover:text-white">Uses</a>
        </nav>
        <ModeToggle client:load />
      </div>
    </div>
  </Container>
</header>
